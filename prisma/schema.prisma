generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(cuid())
  name                   String?
  email                  String         @unique
  emailVerified          DateTime?
  passwordHash           String?
  image                  String?
  plan                   String         @default("free")
  apiKey                 String?        @unique
  stripeCustomerId       String?        @unique
  stripeSubscriptionId   String?        @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  accounts               Account[]
  sessions               Session[]
  links                  Link[]
  domains                CustomDomain[]
  bioPages               BioPage[]
  webhooks               Webhook[]
  linkFolders            LinkFolder[]
  ownedTeamInvites       TeamInvite[] @relation("OwnedTeams")
  joinedTeamInvites      TeamInvite[] @relation("JoinedTeams")
}

model LinkFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#2563eb")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     Link[]

  @@index([userId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  ownerId    String
  email      String
  role       String    @default("editor")
  token      String    @unique
  acceptedAt DateTime?
  memberId   String?
  createdAt  DateTime  @default(now())
  owner      User      @relation("OwnedTeams", fields: [ownerId], references: [id], onDelete: Cascade)
  member     User?     @relation("JoinedTeams", fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([ownerId, email])
  @@index([ownerId])
  @@index([memberId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CustomDomain {
  id                String   @id @default(cuid())
  userId            String
  hostname          String   @unique
  verified          Boolean  @default(false)
  verificationToken String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  links             Link[]

  @@index([userId])
}

model BioPage {
  id        String    @id @default(cuid())
  userId    String
  slug      String    @unique
  title     String?
  bio       String?
  avatarUrl String?
  theme     String    @default("default")
  links     Json      @default("[]")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  views     BioView[]

  @@index([userId])
}

model BioView {
  id        String   @id @default(cuid())
  bioPageId String
  country   String?
  userAgent String?
  createdAt DateTime @default(now())
  bioPage   BioPage  @relation(fields: [bioPageId], references: [id], onDelete: Cascade)

  @@index([bioPageId])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[] @default(["click"])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Link {
  id               String        @id @default(cuid())
  userId           String
  slug             String        @unique
  destination      String
  title            String?
  tags             String[]      @default([])
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  expiresAt        DateTime?
  passwordHash     String?
  qrColor          String?       @default("#000000")
  iosDestination   String?
  androidDestination String?
  geoRules         Json?
  deviceRules      Json?
  domainId         String?
  folderId         String?
  startsAt         DateTime?
  abVariants       Json?
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain           CustomDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  folder           LinkFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  clicks           Click[]

  @@index([userId])
  @@index([domainId])
  @@index([folderId])
}

model Click {
  id           String   @id @default(cuid())
  linkId       String
  referrer     String?
  userAgent    String?
  country      String?
  variantIndex Int?
  createdAt    DateTime @default(now())
  link         Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([createdAt])
}

model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}